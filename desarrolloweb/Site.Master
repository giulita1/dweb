<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="desarrolloweb.SiteMaster" %>
<%@ Import Namespace="BE" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hotel Patagonia</title>
    <link rel="stylesheet" href="<%= ResolveUrl("~/Styles/site.css") %>" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" />
    <script defer src="<%= ResolveUrl("~/ScriptsJS/site.js") %>"></script>
</head>
<body>
    <form runat="server">

    <header>
        <div class="logo-container">
            <p>HOTEL</p>
        </div>
        <button type="button" id="btn-menu">
            <span class="material-symbols-outlined">menu</span>
        </button>

       <%
            string pagina = Request.Url.AbsolutePath.ToLower();
            bool esInicio = pagina == "/" || pagina.EndsWith("/Inicio.aspx");
            string urlInicio = ResolveUrl("~/UI/Inicio.aspx");
            var usuActual = Session["usuario"] as desarrolloweb.BE.Usuario;
            bool logueado = usuActual != null;
            bool puedeGestionarPerfiles = logueado && usuActual.Perfil?.TienePermiso("GestionPerfiles") == true;
            bool puedeReservar        = logueado && usuActual.Perfil?.TienePermiso("RegistrarReserva") == true;
            bool puedeVerReservas     = logueado && usuActual.Perfil?.TienePermiso("VerReservas") == true;
            bool puedeGestionarUsuarios = logueado && usuActual.Perfil?.TienePermiso("GestionUsuarios") == true;
            bool puedeRespaldar       = logueado && usuActual.Perfil?.TienePermiso("Respaldos") == true;
            bool puedeVerDigitos      = logueado && usuActual.Perfil?.TienePermiso("DigitoVerificador") == true;
            bool puedeGestionarIdiomas  = logueado && usuActual.Perfil?.TienePermiso("CambiarIdioma") == true;
        %>
        <nav id="nav-menu">
            <ul>

               <% if (!esInicio) { %>
<li class="nav-items">
   <a href="<%= urlInicio %>" class="nav-inicio"
       style="font-family:'Montserrat', sans-serif; font-size:0.88rem; letter-spacing:0.3px; color:rgba(63,57,54); opacity:1;">
        <asp:Literal ID="litNavInicio" runat="server" Text="Inicio" />
    </a>
</li>
<% } %>

                <li class="nav-items">
                    <asp:DropDownList ID="ddlIdiomaMaster" runat="server"
    AutoPostBack="True"
    OnSelectedIndexChanged="ddlIdiomaMaster_SelectedIndexChanged"
    CssClass="selector-idioma"
    style="font-family:'Montserrat', sans-serif; font-size:0.88rem; letter-spacing:0.3px; color:rgba(63,57,54); cursor:pointer; " />
                </li>

                <% if (logueado) { %>
                <li class="nav-items">
                    <button type="button" id="btn-perfil">
                        <span class="material-symbols-outlined">account_circle</span>
                    </button>
                </li>

                <% if (puedeReservar) { %>
                    <li class="nav-items">
                        <button type="button" id="btn-carrito">
                            <span class="material-symbols-outlined">shopping_cart</span>
                        </button>
                    </li>
                <% } %>
            <% } %>

            </ul>
        </nav>

    </header>

    <main>
        <asp:ContentPlaceHolder ID="MainContent" runat="server" />
    </main>

    <footer class="footer">
        <div class="footer-contenido">
            <div class="footer-seccion">
                <h3><asp:Literal ID="litFooterContacto" runat="server" Text="Contacto" /></h3>
                <p>hotelpatagonia2026@gmail.com</p>
                <p>+54 11 1234-5678</p>
            </div>
            <div class="footer-seccion">
                <h3><asp:Literal ID="litFooterUbicacion" runat="server" Text="Ubicación" /></h3>
                <p>Av. Patagonia 1250</p>
                <p>Bariloche, Río Negro</p>
                <p>Argentina</p>
            </div>
        </div>
        <div class="footer-bottom">
            <asp:Literal ID="litFooterDerechos" runat="server" Text="© 2026 Hotel Patagonia. Todos los derechos reservados." />
        </div>
    </footer>

    <%-- ── Carrito ── --%>
    <% if (puedeReservar) { %>
    <div id="overlay-carrito"></div>
    <div id="carrito">

        <div class="carrito-header">
            <h2><asp:Literal ID="litCarritoTitulo" runat="server" Text="Tu carrito" /></h2>
            <button type="button" id="btn-cerrar-carrito">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>

        <div class="carrito-contenido" id="carrito-contenido">

            <div class="carrito-vacio" id="carrito-vacio">
                <span class="material-symbols-outlined">hotel</span>
                <p><asp:Literal ID="litCarritoVacio" runat="server" Text="Todavía no seleccionaste ninguna habitación." /></p>
            </div>

            <div id="carrito-item" style="display:none">

                <div class="item-habitacion">
                    <div class="item-img-wrapper">
                        <img id="carrito-img" src="" alt="Habitación">
                    </div>
                    <div class="item-info">
                        <span class="item-tipo" id="carrito-tipo"></span>
                        <h3 id="carrito-nombre"></h3>
                        <p class="item-fechas" id="carrito-fechas"></p>
                        <p class="item-noches" id="carrito-noches"></p>
                    </div>
                </div>

                <div class="carrito-extra">
                    <label class="extra-item">
                        <span class="extra-info">
                            <span class="material-symbols-outlined">free_breakfast</span>
                            <span class="extra-info-texto">
                                <span class="extra-titulo"><asp:Literal ID="litDesayunoIncluido" runat="server" Text="Desayuno incluido" /></span>
                                <small><asp:Literal ID="litDesayunoSub" runat="server" Text="Por persona, por noche" /></small>
                            </span>
                        </span>
                        <span class="extra-derecha">
                            <span id="precio-desayuno">+ $5.000</span>
                            <input type="checkbox" id="chk-desayuno">
                        </span>
                    </label>
                </div>

            </div>

        </div>

        <div class="carrito-footer" id="carrito-footer" style="display:none">
            <div class="total-desglose">
                <div class="total-fila">
                    <span id="lbl-precio-hab"></span>
                    <span id="val-precio-hab"></span>
                </div>
                <div class="total-fila" id="fila-desayuno" style="display:none">
                    <span id="lbl-desayuno"></span>
                    <span id="val-desayuno"></span>
                </div>
                <div class="total-fila total-final">
                    <span><asp:Literal ID="litCarritoTotal" runat="server" Text="Total" /></span>
                    <span id="val-total"></span>
                </div>
            </div>
            <button type="button" class="btn-confirmar" id="btn-confirmar">
                <asp:Literal ID="litBtnConfirmarReservaCarrito" runat="server" Text="Confirmar reserva" />
            </button>
        </div>

    </div>
    <% } %>

    <%-- ── Panel perfil ── --%>
    <% if (logueado) { %>
    <div id="overlay-perfil"></div>
    <div id="panel-perfil">

        <div class="perfil-header">
            <div class="perfil-avatar">
                <span class="material-symbols-outlined">account_circle</span>
            </div>
            <div class="perfil-info">
               <h2><%= usuActual.Nombre %> <%= usuActual.Apellido %></h2>
               <p><%= usuActual.Email %></p>
            </div>
            <button type="button" id="btn-cerrar-perfil">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>

        <div class="perfil-contenido">

                <% if (puedeGestionarUsuarios) { %>
                <a href="<%= ResolveUrl("~/UI/GestionUsuarios.aspx") %>" class="perfil-item">
                    <span class="material-symbols-outlined">group</span>
                    <div>
                        <p><asp:Literal ID="litMenuGestionUsuarios" runat="server" Text="Gestión de Usuarios" /></p>
                        <small><asp:Literal ID="litMenuGestionUsuariosSub" runat="server" Text="Administrá los usuarios" /></small>
                    </div>
                    <span class="material-symbols-outlined perfil-chevron">chevron_right</span>
                </a>
                <a href="<%= ResolveUrl("~/UI/Bitacora.aspx") %>" class="perfil-item">
                    <span class="material-symbols-outlined">history</span>
                    <div>
                        <p><asp:Literal ID="litMenuBitacora" runat="server" Text="Bitácora" /></p>
                        <small><asp:Literal ID="litMenuBitacoraSub" runat="server" Text="Registro de actividad" /></small>
                    </div>
                    <span class="material-symbols-outlined perfil-chevron">chevron_right</span>
                </a>
                <% } %>

                <% if (puedeGestionarIdiomas) { %>
                <a href="<%= ResolveUrl("~/UI/GestionIdioma.aspx") %>" class="perfil-item">
                    <span class="material-symbols-outlined">language</span>
                    <div>
                        <p><asp:Literal ID="litMenuGestionIdiomas" runat="server" Text="Gestión de Idiomas" /></p>
                        <small><asp:Literal ID="litMenuGestionIdiomasSub" runat="server" Text="Agregá y traducí idiomas" /></small>
                    </div>
                    <span class="material-symbols-outlined perfil-chevron">chevron_right</span>
                </a>
                <% } %>

                <% if (puedeRespaldar) { %>
                <a href="<%= ResolveUrl("~/UI/BackupRestore.aspx") %>" class="perfil-item">
                    <span class="material-symbols-outlined">backup</span>
                    <div>
                        <p><asp:Literal ID="litMenuBackupRestore" runat="server" Text="Backup / Restore" /></p>
                        <small><asp:Literal ID="litMenuBackupRestoreSub" runat="server" Text="Respaldo de datos" /></small>
                    </div>
                    <span class="material-symbols-outlined perfil-chevron">chevron_right</span>
                </a>
                <% } %>

                <% if (puedeVerDigitos) { %>
                <a href="<%= ResolveUrl("~/UI/DigitoVerificador.aspx") %>" class="perfil-item">
                    <span class="material-symbols-outlined">verified</span>
                    <div>
                        <p><asp:Literal ID="litMenuDigitosVerificadores" runat="server" Text="Dígitos Verificadores" /></p>
                        <small><asp:Literal ID="litMenuDigitosVerificadoresSub" runat="server" Text="Control de integridad" /></small>
                    </div>
                    <span class="material-symbols-outlined perfil-chevron">chevron_right</span>
                </a>
                <% } %>

                <% if (puedeGestionarPerfiles) { %>
                <a href="<%= ResolveUrl("~/UI/GestionPerfiles.aspx") %>" class="perfil-item">
                    <span class="material-symbols-outlined">manage_accounts</span>
                    <div>
                        <p><asp:Literal ID="litMenuGestionPerfiles" runat="server" Text="Gestión de Perfiles" /></p>
                        <small><asp:Literal ID="litMenuGestionPerfilesSub" runat="server" Text="Administrá perfiles y permisos" /></small>
                    </div>
                    <span class="material-symbols-outlined perfil-chevron">chevron_right</span>
                </a>
                <% } %>

                <% if (puedeVerReservas) { %>
                <a href="<%= ResolveUrl("~/UI/MisReservas.aspx") %>" class="perfil-item">
                    <span class="material-symbols-outlined">luggage</span>
                    <div>
                        <p><asp:Literal ID="litMenuMisReservas" runat="server" Text="Mis Reservas" /></p>
                        <small><asp:Literal ID="litMenuMisReservasSub" runat="server" Text="Revisá y gestioná tus reservas" /></small>
                    </div>
                    <span class="material-symbols-outlined perfil-chevron">chevron_right</span>
                </a>
                <% } %>

                <% if (puedeReservar) { %>
                <a href="<%= ResolveUrl("~/UI/Reservar.aspx") %>" class="perfil-item">
                    <span class="material-symbols-outlined">hotel_class</span>
                    <div>
                        <p><asp:Literal ID="litMenuNuevaReserva" runat="server" Text="Nueva Reserva" /></p>
                        <small><asp:Literal ID="litMenuNuevaReservaSub" runat="server" Text="Buscá tu próxima estadía" /></small>
                    </div>
                    <span class="material-symbols-outlined perfil-chevron">chevron_right</span>
                </a>
                <% } %>

        </div>

        <div class="perfil-footer">
            <asp:LinkButton ID="btnCerrarSesion2" runat="server"
                OnClick="btnCerrarSesion_Click"
                CssClass="btn-cerrar-sesion">
                <span class="material-symbols-outlined">logout</span>
                <asp:Literal ID="litCerrarSesion" runat="server" Text="Cerrar sesión" />
            </asp:LinkButton>
        </div>

    </div>
    <% } %>

    </form>
</body>
</html>